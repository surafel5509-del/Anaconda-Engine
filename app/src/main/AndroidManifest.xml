<?xml version="1.0" encoding="utf-8"?>
<!--
  Anaconda-Engine — app manifest.

  Key declarations:
  * glEsVersion 0x00030000 -> OpenGL ES 3.0 is REQUIRED (core renderer target).
  * configChanges on the activity keeps the GLSurfaceView alive across
    rotation/keyboard events instead of tearing down the EGL context — critical
    for an editor where losing the surface means reloading the scene.
  * hardwareAccelerated is implicit for modern Android but declared for clarity.
-->
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <!-- Device must support OpenGL ES 3.0. -->
    <uses-feature
        android:glEsVersion="0x00030000"
        android:required="true" />

    <!-- Vibrate is reserved for future editor haptics (snap/gizmo feedback). -->
    <uses-permission android:name="android.permission.VIBRATE" />

    <application
        android:allowBackup="true"
        android:hardwareAccelerated="true"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:supportsRtl="true"
        android:theme="@style/Theme.Anaconda">

        <activity
            android:name=".MainActivity"
            android:configChanges="orientation|screenSize|screenLayout|keyboardHidden|smallestScreenSize|density"
            android:exported="true"
            android:launchMode="singleTask"
            android:windowSoftInputMode="adjustResize">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>
    </application>

</manifest>
